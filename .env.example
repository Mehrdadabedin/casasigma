# Optional overrides. The defaults match the project-local cluster started by
# `npm run db:start`, so this file is only needed for a hosted database.
DATABASE_URL=postgres://casasigma@127.0.0.1:5434/casasigma
API_PORT=8787

# Passwords are never stored in the repository. Leave these empty locally and
# `npm run db:seed:users` generates random ones and prints them once.
# In production both must be set.
DEMO_PASSWORD=
ADMIN_STARTER_PASSWORD=
