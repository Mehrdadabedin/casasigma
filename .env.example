# Optional overrides. The defaults match the project-local cluster started by
# `npm run db:start`, so this file is only needed for a hosted database.
DATABASE_URL=postgres://casasigma@127.0.0.1:5434/casasigma
API_PORT=8787
# Address the API listens on. Loopback by default; a hosted service sets 0.0.0.0.
API_HOST=

# The built web app the API serves next to /api. Defaults to dist/ when
# NODE_ENV=production; in development Vite serves the page instead.
WEB_DIST=

# Keeps every CasaSigma table in this schema, for sharing another app's
# database (see db/shared-database-setup.sql). Leave empty for a database of
# CasaSigma's own.
DATABASE_SCHEMA=

# Passwords are never stored in the repository. Leave these empty locally and
# `npm run db:seed:users` generates random ones and prints them once.
# In production both must be set.
DEMO_PASSWORD=
ADMIN_STARTER_PASSWORD=

# Public origin for links in emails. Required in production; never taken from
# request headers. Leave empty on localhost.
APP_ORIGIN=
